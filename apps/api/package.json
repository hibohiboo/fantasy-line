    "ncu": "ncu -u"
  },
  "dependencies": {
    "@repo/schema": "*",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1041.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
