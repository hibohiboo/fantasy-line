{
  "name": "@fantasy-life/api",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "drizzle-kit push --config=drizzle.config.ts",
