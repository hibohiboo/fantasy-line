{
  "name": "@fantasy-life/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ncu": "ncu -u",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "vuetify": "^4.0.8"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "npm-run-all2": "^9.0.1",
    "oxlint": "~1.67.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
