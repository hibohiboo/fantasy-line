{
  "name": "@fantasy-life/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ncu": "npx ncu -u",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@aws-amplify/ui-vue": "^4.4.4",
    "aws-amplify": "^6.18.0",
    "date-fns": "^4.4.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.61.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.70.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
